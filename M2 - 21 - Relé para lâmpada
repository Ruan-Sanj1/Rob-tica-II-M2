int pino_som = ;
int pino_rele = ;

boolean estado = LOW;

void setup() {
pinMode(pino_som, INPUT);
pinMode(pino_rele, OUTPUT);
}

void loop() {
int som = digitalRead(pino_som);
if (som) {
   estado = !estado;                
 digitalWrite(pino_rele, estado);
 delay();                                 
}
}
